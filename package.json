{
  "name": "vaultboard",
  "version": "1.1.11071226",
  "packageManager": "npm@11.14.1",
  "description": "Productivity dashboard for Obsidian with clock-aligned timers and task management",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "node esbuild.config.mjs production && node deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "dashboard",
    "timer",
    "productivity"
  ],
  "author": "Miguel A. Lopez",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.5",
    "builtin-modules": "5.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
